{
  "name": "pitwall-agent",
  "version": "1.0.3",
  "description": "PitWall UDP Agent — background F1 telemetry capture and sync service for Windows",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/all.test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.js",
    "service:install": "node dist/service/install.js",
    "service:uninstall": "node dist/service/uninstall.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "node-windows": "^1.0.0-beta.8",
    "systray2": "^2.1.4",
    "uuid": "^9.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "pkg": "^5.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
