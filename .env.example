# PitWall Agent configuration
# Copied to %APPDATA%\PitWall Agent\.env on first run.

# Deployed PitWall server (packaged builds bake this via PITWALL_DEFAULT_API_URL).
PITWALL_API_URL=http://localhost:3001
# Your PERSONAL pairing token from PitWall → Settings → Connected Games.
# This is what routes ingested sessions to your account (multi-tenant).
PITWALL_AGENT_TOKEN=
# F1 25 sends UDP here; the agent relays a copy to FORWARD_TARGETS (e.g. Moza).
UDP_PORT=20779
UDP_BIND_ADDRESS=0.0.0.0
GAME_VERSION=auto
LOG_LEVEL=info
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=3

# Comma-separated host:port list of OTHER telemetry tools to relay packets
# to (e.g. Moza Pit House, SimHub). Point F1 25's UDP output at PitWall's
# UDP_PORT above ONLY — F1 can only send to one target, so any other tool
# must receive its copy from PitWall's relay instead of listening directly.
# Example: FORWARD_TARGETS=127.0.0.1:20778
FORWARD_TARGETS=
